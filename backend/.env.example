# ==========================================
# TICKETAR - CONFIGURACIÓN DE ENTORNO
# Copiá este archivo como .env y completá tus datos
# ==========================================

# SERVIDOR
PORT=3000
NODE_ENV=production
BASE_URL=https://tu-dominio.com

# SEGURIDAD JWT (cambiá por una clave segura y larga)
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura_32chars
JWT_EXPIRES_IN=24h

# BASE DE DATOS (SQLite - archivo local)
DB_PATH=./database/ticketar.db

# MERCADO PAGO
# Obtené tus credenciales en https://mercadopago.com/developers
MP_ACCESS_TOKEN=APP_USR-tu-access-token-de-produccion
MP_PUBLIC_KEY=APP_USR-tu-public-key
MP_WEBHOOK_SECRET=tu-webhook-secret

# EMAIL (para enviar entradas - usá Gmail o cualquier SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-de-gmail
EMAIL_FROM=TicketAR <tu-email@gmail.com>

# ADMIN INICIAL (se crea al ejecutar npm run init-db)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CambiaEsta_ClaveAdmin_2024!
ADMIN_NAME=Administrador Principal
ADMIN_EMAIL=admin@tu-dominio.com
