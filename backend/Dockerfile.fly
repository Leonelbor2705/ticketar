FROM node:18-alpine

# sqlite3 necesita compilar un módulo nativo — requiere python3/make/g++ en Alpine
RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

COPY . .

ENV NODE_ENV=production
EXPOSE 8080

# init-db corre en cada arranque (no en el build): el volumen persistente de Fly
# solo existe cuando la máquina arranca, no durante el build de la imagen.
# Es seguro repetirlo — usa CREATE TABLE IF NOT EXISTS / INSERT OR IGNORE.
CMD ["sh", "-c", "npm run init-db && npm start"]
